class Node:

    def __init__(self, data):
        self.data = data
        self.next = None


# Linked List banana
node1 = Node(10)
node2 = Node(20)
node3 = Node(30)
node4 = Node(40)
node5 = Node(50)

node1.next = node2
node2.next = node3
node3.next = node4
node4.next = node5

head = node1


# Delete karna hai: 30
value = 30

# Agar head hi delete karna ho
if head.data == value:
    head = head.next

else:
    current = head

    while current.next is not None:

        if current.next.data == value:
            current.next = current.next.next
            break

        current = current.next


